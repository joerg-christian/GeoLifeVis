///////////////
// Keep in sync with host:

const uint numberOfLabels = 10;
int maxRowLength = 11;
int maxColLength = 11;
int maxKernelSize = 5;
ivec2 mapResolution = ivec2(1280,1280);

// 3x3 Gauss Kernel Approximation 3x3
// 1 2 1
// 2 4 2
// 1 2 1
const mat3 kernel3x3 = mat3(0.25,0.5,0.25,0.5,1,0.5,0.25,0.5,0.25);

// Data Structure for the geoLife Data Points
struct GeoLifeData
{
	float x;
	float y;
	int year;
	int month;
	int day;
    int weekday;
	int hour;
	int minute;
	int second;
