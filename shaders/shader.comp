};

// Data Structure for user parameters that set limits within which geoLife data points are consideres
struct UserParameters 
{
    uint maxIndexDataSet;
    uint resX;
    uint resY;
    uint runCompute;
    int kernelSize;
    int yearMin;
    int yearMax;
    int monthMin;
    int monthMax;
    int dayMin;
    int dayMax;
    int hourMin;
    int hourMax;
    float sigma;
    int kernelChanged;
    int labelNA ;
	int labelWALK;
	int labelBIKE;
	int labelBUS;
	int labelCAR;
	int labelSUBWAY;
	int labelTRAIN;
	int labelAIRPLANE;
	int labelBOAT;
	int labelMOTORCYCLE;
    int labelMonday;
    int labelTuesday;
    int labelWednesday;
    int labelThursday;
    int labelFriday;
    int labelSaturday;
    int labelSunday;
